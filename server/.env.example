# Craftly Enterprise Backend Environment Variables
PORT=4000
NODE_ENV=development

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://craftly:craftly_secret@localhost:5432/craftly_db?schema=public"

# Redis Cache & Queues
REDIS_URL="redis://localhost:6379"

# Authentication & Security
JWT_SECRET="craftly_dev_jwt_secret_key_change_in_production_min_32_chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="craftly_dev_refresh_secret_key_change_in_production_min_32_chars"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:5173"

# Payments (Razorpay Sandbox)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_test_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"
